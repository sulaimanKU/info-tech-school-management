APP_NAME="INFO-TECH School API"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
APP_LOCALE=en
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=infotech_school
DB_USERNAME=infotech_app
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
LOG_CHANNEL=single
LOG_LEVEL=warning
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Parent identity and external providers; local SMS is forbidden outside local/testing.
CNIC_LOOKUP_KEY=
SMS_DRIVER=disabled
# Full approved HTTPS /sendsms endpoint; provision the key privately, never in source.
SPEXT_API_URL=
SPEXT_API_KEY=
SCHOOL_UPLOAD_MAX_KB=5120
PUSH_DRIVER=disabled
WHATSAPP_DRIVER=disabled

# Absolute private path outside the served web root. Never commit the JSON key.
FIREBASE_CREDENTIALS=
